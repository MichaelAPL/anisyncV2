# Kamal reads this file when it deploys. It holds NO secret values: each line reads the value from your shell
# environment (or swap in a password-manager lookup, e.g. $(op read op://AniSyncHub/...)).
# Never commit real values here.
#
# Not listed on purpose: the anisync_owner password used by migrations. It lives only in /etc/anisync/migrator.env
# on the server (mode 0600) and in the db accessory's env, which needs it to create the role.

# App
DATABASE_URL=$ANISYNC_APP_DATABASE_URL
SESSION_SECRET=$ANISYNC_SESSION_SECRET
TOKEN_ENCRYPTION_KEYS=$ANISYNC_TOKEN_ENCRYPTION_KEYS
MAL_CLIENT_ID=$ANISYNC_MAL_CLIENT_ID
MAL_CLIENT_SECRET=$ANISYNC_MAL_CLIENT_SECRET
ANILIST_CLIENT_ID=$ANISYNC_ANILIST_CLIENT_ID
ANILIST_CLIENT_SECRET=$ANISYNC_ANILIST_CLIENT_SECRET
SENTRY_DSN=$ANISYNC_SENTRY_DSN
SIGNUP_ALLOWLIST=$ANISYNC_SIGNUP_ALLOWLIST
ADMIN_USER_IDS=$ANISYNC_ADMIN_USER_IDS

# Database accessory (creates the roles on first start)
POSTGRES_PASSWORD=$ANISYNC_POSTGRES_PASSWORD
ANISYNC_OWNER_PASSWORD=$ANISYNC_OWNER_PASSWORD
ANISYNC_APP_PASSWORD=$ANISYNC_APP_PASSWORD
ANISYNC_BACKUP_PASSWORD=$ANISYNC_BACKUP_PASSWORD

# Cloudflare Tunnel
TUNNEL_TOKEN=$ANISYNC_TUNNEL_TOKEN

# Backups
PGPASSWORD=$ANISYNC_BACKUP_PASSWORD
AGE_RECIPIENT=$ANISYNC_AGE_RECIPIENT
R2_ACCOUNT_ID=$ANISYNC_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=$ANISYNC_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=$ANISYNC_R2_SECRET_ACCESS_KEY
R2_BUCKET=$ANISYNC_R2_BUCKET
BACKUP_HEARTBEAT_URL=$ANISYNC_BACKUP_HEARTBEAT_URL
