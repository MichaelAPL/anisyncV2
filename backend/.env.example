DATABASE_URL=postgresql://anisync:anisync@localhost:5434/anisync
PUBLIC_URL=http://localhost:5173
SESSION_SECRET=change-me
# Key that encrypts provider tokens at rest: `uv run anisync generate-key`
TOKEN_ENCRYPTION_KEY=
# To rotate: TOKEN_ENCRYPTION_KEYS=<new>,<old>, deploy, `uv run anisync rotate-keys`, then drop <old>.
# TOKEN_ENCRYPTION_KEYS=

# https://myanimelist.net/apiconfig  (App Redirect URL: http://localhost:5173/auth/mal/callback)
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
# https://anilist.co/settings/developer  (Redirect URL: http://localhost:5173/auth/anilist/callback)
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
# Optional; Kitsu's password grant currently works without them.
KITSU_CLIENT_ID=
KITSU_CLIENT_SECRET=

RUN_WORKER_IN_PROCESS=true
# Scheduler tick (UTC). Keep it hourly: each tick syncs the users whose hour it is, so everyone is synced once a day.
SYNC_TICK_CRON=0 * * * *

# Offline dataset that pre-fills the cross-provider ID mapping (defaults shown; see seed.py)
# ID_DATASET_URL=https://github.com/cedya77/anime-offline-database/releases/latest/download/anime-offline-database.jsonl
# ID_DATASET_CRON=0 3 * * 0

# Comma-separated AniSync user ids made admins (when they exist; never demotes). See ROADMAP 4.0.
ADMIN_USER_IDS=
